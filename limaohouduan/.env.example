# 服务器端口
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=你的数据库用户名
DB_PASSWORD=你的数据库密码
DB_NAME=你的数据库名称

# 163邮箱配置（用于发送验证码）
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USER=你的163邮箱@163.com
MAIL_PASS=你的163邮箱授权码（不是登录密码）

# JWT密钥（用于生成token，建议用随机字符串）
JWT_SECRET=至少32位的随机字符串

# 跨域配置
CORS_ORIGIN=http://localhost:5173

# 高德地图API Key（如果需要）
# AMAP_KEY=你的高德地图Key

# AI API Keys（可选，也可以在前端配置）
# AI_API_KEY=你的AI密钥

# NVIDIA Build API Key（用于免费调用 GLM/DeepSeek/千问/Kimi/MiniMax 等模型）
# 申请地址: https://build.nvidia.com
NVIDIA_API_KEY=你的NVIDIA_API_KEY

# 支付宝支付配置
ALIPAY_APP_ID=你的支付宝应用APPID
ALIPAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n你的应用私钥内容\n-----END PRIVATE KEY-----
ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n支付宝公钥内容\n-----END PUBLIC KEY-----
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://你的后端域名/api/payment/notify
ALIPAY_RETURN_URL=https://你的前端域名
